{
  "name": "webide-dev",
  "displayName": "Web IDE Dev Environment (Nodine)",
  "description": "Real Node.js dev environment in the browser: nodine runtime terminal, import from GitHub, upload local folder.",
  "publisher": "amplytic",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true,
      "description": "Runs entirely in the browser"
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onFileSystem:nodine",
    "onStartupFinished"
  ],
  "browser": "./dist/browser/extensionMain",
  "contributes": {
    "commands": [
      {
        "command": "webide-dev.createTerminal",
        "title": "Create Dev Terminal",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.importGithub",
        "title": "Import from GitHub...",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.uploadFolder",
        "title": "Upload Local Folder...",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.runFile",
        "title": "Run Current File with Node",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.previewPort",
        "title": "Open Preview Port...",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.createNodineTerminal",
        "title": "Create Nodine Terminal",
        "category": "Web IDE"
      },
      {
        "command": "webide-dev.shareLan",
        "title": "Share Dev Server on LAN (QR)...",
        "category": "Web IDE"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "webide-dev.runFile",
          "group": "webide@1"
        }
      ]
    },
    "configuration": {
      "title": "Web IDE Dev",
      "properties": {
        "webide-dev.runtimeUrl": {
          "type": "string",
          "default": "/nodine/supervisor.mjs",
          "description": "URL of the nodine runtime bundle (supervisor.mjs)"
        },
        "webide-dev.githubMaxFileKb": {
          "type": "number",
          "default": 512,
          "description": "Max file size (KB) when importing from GitHub"
        },
        "webide-dev.githubToken": {
          "type": "string",
          "default": "",
          "description": "Optional GitHub PAT (raises rate limits, enables private repos)"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "webide-dev.welcome",
        "contents": "Bring a project into the dev environment \u2014 real Node.js in your browser.\n[Upload Folder](command:webide-dev.uploadFolder)\n[Import from GitHub...](command:webide-dev.importGithub)\n[Open Dev Terminal](command:webide-dev.createTerminal)",
        "when": "webide-dev.noProject"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "webide-dev.welcome",
          "name": "Dev Environment",
          "when": "webide-dev.noProject",
          "order": 0,
          "visibility": "visible"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "webide-dev.nodine",
          "title": "Nodine (Node.js)",
          "icon": "terminal"
        }
      ]
    }
  }
}